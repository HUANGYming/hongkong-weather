DB_PASS=replace_with_real_password

# Airflow Docker mode does not read this file.
# This file is mainly for manual docker run --env-file and local uv runs.
# In Airflow, store DB_PASS as Admin Variable hko_weather_db_password.
# The code has DEV ZONE defaults for DB_HOST, DB_PORT, DB_NAME, DB_USER, HKO_DB_SCHEMA,
# and HKO_RAW_RETENTION_DAYS. Add them here only if you need to override defaults.
