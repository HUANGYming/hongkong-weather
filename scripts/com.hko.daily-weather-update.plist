<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hko.daily-weather-update</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/YOUR_USERNAME/.hko_weather/update_hko_database.py</string>
    <string>--db</string>
    <string>/Users/YOUR_USERNAME/.hko_weather/data/hko_weather.sqlite</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/YOUR_USERNAME/.hko_weather</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/.hko_weather/logs/hko_update.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/.hko_weather/logs/hko_update.err.log</string>

  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
